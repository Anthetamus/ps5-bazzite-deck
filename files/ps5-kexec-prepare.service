[Unit]
Description=Warm reboot into Linux: load the kernel from the boot partition before the reboot
# Pulled in by reboot.target only (never by poweroff), while the boot partition is still mounted.
# Switch warm reboots off with: systemctl mask ps5-kexec-prepare   (back on: unmask)
DefaultDependencies=no
Before=shutdown.target umount.target final.target ps5-reboot.service

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/ps5-kexec load
