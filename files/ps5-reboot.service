[Unit]
Description=Reboot: warm reboot into Linux when a kernel is loaded, normal reboot otherwise
DefaultDependencies=no
Requires=shutdown.target umount.target final.target
After=shutdown.target umount.target final.target
SuccessAction=reboot-force
FailureAction=reboot-force

[Service]
Type=oneshot
# "systemctl --force kexec" only returns if it couldn't kexec: then a normal reboot
ExecStart=/bin/sh -c '[ "$(cat /sys/kernel/kexec_loaded 2>/dev/null)" = 1 ] && /usr/bin/systemctl --force kexec; exec /usr/bin/systemctl --force reboot'
