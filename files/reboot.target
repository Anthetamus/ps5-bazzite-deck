# Overrides systemd's reboot.target: every reboot (Steam, the desktop, "sudo reboot") goes through
# ps5-reboot.service, which warm-reboots into Linux when ps5-kexec-load.service loaded a kernel.
[Unit]
Description=System Reboot
Documentation=man:systemd.special(7)
DefaultDependencies=no
Requires=ps5-reboot.service
After=ps5-reboot.service
AllowIsolate=yes
JobTimeoutSec=30min
JobTimeoutAction=reboot-force

[Install]
Alias=ctrl-alt-del.target
