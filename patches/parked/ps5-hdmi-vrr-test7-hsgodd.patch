PS5 HDMI: VRR test 7 (hdmi.vrr_test=1), Sony's VSync block AFTER link training   [ps5-bazzite-deck]

Test 6 wrote the VRR VSync block from amdgpu before the video setup, i.e. before
configLinkTrainingFlava3(); the resulting log shows
"perform_8b_10b_clock_recovery_sequence: Link Training Error, could not get CR
after 100 tries" and a re-announce loop (got real edid -> re-arm). In the stock
OS the block is written from inside setHdmiBasicVideoConfigFlava3, i.e. AFTER
the link is trained (call site 0x4B43CF), while the VRR-dependent 0x6224 write
sits in configParamFlava3Pre, i.e. BEFORE training (code 0x4B2622).

This patch:
 * writes Sony's VSync block at the end of setHdmiBasicVideoConfigFlava3
   (1047=30 6064=03 6c07=80 7214=80,02 when VRR is on),
 * adds the VRR variant of 0x6224 in configParamFlava3Pre,
 * does NOT touch ignore_msa_timing_param (test 6 set it; it cannot affect
   clock recovery and is not needed for the block),
 * keeps the FreeSync InfoFrame behind hdmi.vrr_vsif_enable, off by default
   (the PS5 signals HDMI 2.1 VTEM, not AMD FreeSync),
 * is opt-in with hdmi.vrr_test=1, off by default; not for a release.
---

--- a/drivers/ps5/hdmi.c
+++ b/drivers/ps5/hdmi.c
@@ -648,15 +648,78 @@
 	i2c_exec();
 }
 
+/*
+ * Sony's VRR VSync block, taken from PS5 OS 13.60 kernel dumps (flag at
+ * 0x3536698, block configVSyncSettingFlava3 @0x4B8B60, call site 0x4B43CF).
+ * The block must be programmed AFTER the DP link is trained; doing it before
+ * makes link training fail ("could not get CR after 100 tries").
+ */
+static bool vrr_test;
+module_param(vrr_test, bool, 0444);
+MODULE_PARM_DESC(vrr_test, "VRR test: write Sony's VRR VSync block after link training");
+static bool vrr_runtime;
+static bool vrr_vsif_enable;
+module_param(vrr_vsif_enable, bool, 0644);
+MODULE_PARM_DESC(vrr_vsif_enable, "also send the HDMI FreeSync InfoFrame (default off)");
+static unsigned int vrr_min_hz = 40;
+static unsigned int vrr_max_hz = 120;
+
+static bool vrr_enabled(void)
+{
+	return (vrr_test || vrr_runtime) && hdmi_ic_type == HDMI_IC_TYPE_FLAVA3;
+}
+
+void sceHdmiSetFreesyncInfoframe(u8 flags, u8 min_hz, u8 max_hz);
+
+void sceHdmiSetFreesyncInfoframe(u8 flags, u8 min_hz, u8 max_hz)
+{
+	u8 pkt[30] = { 0x83, 0x01, 0x08, 0x00, 0x1a, 0x00, 0x00, 0x00, 0x00 };
+	u8 sum = 0;
+	int i;
+
+	if (hdmi_ic_type != HDMI_IC_TYPE_FLAVA3 || !(flags & 0x02))
+		return;
+
+	pkt[9] = flags;
+	pkt[10] = min_hz;
+	pkt[11] = max_hz;
+	for (i = 0; i < 12; i++)
+		sum += pkt[i];
+	pkt[3] = (u8)(0x100 - sum);
+
+	i2c_init(1);
+	i2c_write_data(0x7e40, pkt, sizeof(pkt));
+	i2c_mask(0x7203, 0x01, 0x01);
+	i2c_write(0x7204, 0x01);
+	i2c_waitclear(0x7204, 0x01);
+	i2c_exec();
+	pr_info("hdmi: FreeSync InfoFrame flags=%02x %u-%u Hz\n", flags, min_hz, max_hz);
+}
+EXPORT_SYMBOL(sceHdmiSetFreesyncInfoframe);
+
+void sceHdmiSetVrr(int on)
+{
+	vrr_runtime = !!on;
+}
+EXPORT_SYMBOL(sceHdmiSetVrr);
+
 static void configVSyncSettingFlava3(void)
 {
+	bool vrr = vrr_enabled();
+	u8 v1047 = vrr ? 0x30 : 0x00, v6064 = vrr ? 0x03 : 0x01;
+	u8 v6c07 = vrr ? 0x80 : 0x00;
+	u8 v7214a = vrr ? 0x80 : 0x00, v7214b = vrr ? 0x02 : 0x00;
+
+	pr_info("hdmi: VSync block vrr=%d 1047=%02x 6064=%02x 6c07=%02x 7214=%02x,%02x\n",
+		vrr, v1047, v6064, v6c07, v7214a, v7214b);
+
 	i2c_init(1);
 	i2c_begin_block();
-	i2c_write(0x1047, 0x00);
-	i2c_write(0x6064, 0x01);
+	i2c_write(0x1047, v1047);
+	i2c_write(0x6064, v6064);
 	i2c_write_data(0x600c, (u8[]){0x01, 0x00}, 2);
-	i2c_write(0x6c07, 0x00);
-	i2c_write_data(0x7214, (u8[]){0x00, 0x00}, 2);
+	i2c_write(0x6c07, v6c07);
+	i2c_write_data(0x7214, (u8[]){v7214a, v7214b}, 2);
 	i2c_end_block();
 	i2c_exec();
 }
@@ -665,7 +728,7 @@
 {
 	i2c_init(1);
 	i2c_begin_block();
-	i2c_write_data(0x6224, (u8[]){0x00, 0x01}, 2);
+	i2c_write_data(0x6224, vrr_enabled() ? (u8[]){0x40, 0x0f} : (u8[]){0x00, 0x01}, 2);
 	i2c_write_data(0x1047, (u8[]){0x00}, 1);
 	i2c_write_data(0x1050, (u8[]){0x00, 0x00, 0x00, 0x00}, 4);
 	i2c_write(0x7215, 0x00);
@@ -858,8 +921,12 @@
 	i2c_end_block();
 	i2c_waitclear(0x7011, 0xff);
 	i2c_exec();
-}
 
+	/* the stock OS writes the VRR VSync block on every mode set, after training */
+	configVSyncSettingFlava3();
+	if (vrr_enabled() && vrr_vsif_enable)
+		sceHdmiSetFreesyncInfoframe(0x07, vrr_min_hz, vrr_max_hz);
+}
 
 static void setVideoAdditionalConfigFlava3(const struct drm_display_mode *mode)
 {
