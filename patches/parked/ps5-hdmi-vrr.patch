+		 * FreeSync InfoFrame through the HDMI bridge while VRR is switched on
+		 * (supported / enabled / active, the range amdgpu uses), off otherwise.
+		 */
+		if (ps5_hdmi_vrr_possible() && dm_new_crtc_state->stream) {
+			const struct mod_freesync_config *fc = &dm_new_crtc_state->freesync_config;
+
+			if (fc->state == VRR_STATE_ACTIVE_VARIABLE)
+				sceHdmiSetFreesyncInfoframe(0x07, fc->min_refresh_in_uhz / 1000000,
+							    fc->max_refresh_in_uhz / 1000000);
+			else
+				sceHdmiSetFreesyncInfoframe(0, 0, 0);
+		}
+#endif
 	}
 
 	/* Enable writeback */
