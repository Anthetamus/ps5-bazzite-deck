+/*
+ * VRR (FreeSync) through the HDMI bridge, offered when the sink's EDID has an
+ * AMD FreeSync block (FLAVA3 only) and used when VRR is switched on in the
+ * desktop or Game Mode settings.
+ *
+ * amdgpu only offers VRR on a DP sink that may ignore the MSA timing and has
+ * a refresh range; the bridge reports neither, and 7.3 doesn't read the range
+ * of an HDMI sink behind DP. So the range comes from the sink's FreeSync block
+ * here. Not from the HDMI Forum VRR range: HDMI VRR needs VTEM packets, which
+ * the bridge isn't known to send. Not from the range limits descriptor: TVs
+ * list one without VRR, and with FreeSync off in the TV the block is gone.
+ * amdgpu doesn't set "ignore MSA timing" on the bridge (it loses the picture
+ * then, even with VRR off: v1.4.0-rc1), and the FreeSync InfoFrame goes out
+ * through the bridge's InfoFrame slot while VRR is switched on (not amdgpu's
+ * own FreeSync SDP, which it would send as "enabled" even with VRR off), so
+ * the TV knows. Whether the bridge passes a varying frame timing on is still open.
+ */
+
+static u8 vrr_edid[512];
+static int vrr_edid_len;
+static DEFINE_SPINLOCK(vrr_edid_lock);
+
+/* copy of the sink's EDID for the VRR range, bounded by what the message holds */
+static void ps5_vrr_save_edid(const struct icc_msg *msg)
+{
+	int len = *(const u16 *)&msg->data[2];
+	int avail = (int)msg->length - (int)sizeof(*msg) - 4;
+	unsigned long flags;
+
+	len = clamp(min(len, avail), 0, (int)sizeof(vrr_edid));
+	spin_lock_irqsave(&vrr_edid_lock, flags);
+	memcpy(vrr_edid, &msg->data[4], len);
+	vrr_edid_len = len;
+	spin_unlock_irqrestore(&vrr_edid_lock, flags);
+}
+
+bool ps5_hdmi_vrr_possible(void)
+{
+	return hdmi_ic_type == HDMI_IC_TYPE_FLAVA3;
+}
+EXPORT_SYMBOL(ps5_hdmi_vrr_possible);
+
+int ps5_hdmi_vrr_range(int *min_hz, int *max_hz, const char **src)
+{
+	int amd_min = 0, amd_max = 0;
+	int ext, n, i, len;
+	unsigned long flags;
+	u8 *e;
+
+	e = kmalloc(sizeof(vrr_edid), GFP_KERNEL);
+	if (!e)
+		return -ENOMEM;
+	spin_lock_irqsave(&vrr_edid_lock, flags);
+	len = vrr_edid_len;
+	memcpy(e, vrr_edid, len);
+	spin_unlock_irqrestore(&vrr_edid_lock, flags);
+
+	if (len < 128) {
+		kfree(e);
+		return -ENODATA;
+	}
+
+	n = e[0x7e];
+	for (ext = 1; ext <= n && (ext + 1) * 128 <= len; ext++) {
+		const u8 *b = &e[ext * 128];
+		int d = b[2];
+
+		if (b[0] != 0x02 || d < 4 || d > 127)
+			continue;
+		for (i = 4; i < d; i += 1 + (b[i] & 0x1f)) {
+			int tag = b[i] >> 5, l = b[i] & 0x1f;
+			const u8 *p = &b[i + 1];
+
+			if (tag != 3 || l < 3 || i + 1 + l > d)
+				continue;
+			if (p[0] == 0x1a && p[1] == 0x00 && p[2] == 0x00 && l >= 7) {
+				/* AMD FreeSync VSDB: version, flags, min, max */
+				amd_min = p[5];
+				amd_max = p[6];
+			}
+		}
+	}
+
+	kfree(e);
+
+	if (amd_min < 1 || amd_max <= amd_min + 10)
+		return -ENODATA;
+	*min_hz = amd_min;
+	*max_hz = amd_max;
+	*src = "FreeSync block";
+	return 0;
+}
+EXPORT_SYMBOL(ps5_hdmi_vrr_range);
+
+static int vrr_vsif_last = -1;		/* flags | min << 8 | max << 16 last sent, -1: resend */
+static bool vrr_vsif_on;		/* the 0x7e40 slot holds our InfoFrame */
+
+/* the bridge's packet setup was rewritten (mode set, HDR InfoFrame): send again */
+static void ps5_vrr_vsif_invalidate(bool slot_lost)
+{
+	vrr_vsif_last = -1;
+	if (slot_lost)
+		vrr_vsif_on = false;
+}
+
+/*
+ * FreeSync InfoFrame, as amdgpu builds it for HDMI (SPD v1: OUI 0x00001A,
+ * PB6 bit 0 supported / 1 enabled / 2 active, PB7 min, PB8 max refresh).
+ * FLAVA3 only, through the bridge's InfoFrame slot at 0x7e40, which the HDR
+ * InfoFrame uses too: never while HDR is on. flags without "enabled" (VRR
+ * switched off in the settings, or not supported in the mode) switch it off.
+ */
+void sceHdmiSetFreesyncInfoframe(u8 flags, u8 min_hz, u8 max_hz)
+{
+	u8 pkt[30] = { 0x83, 0x01, 0x08, 0x00, 0x1a, 0x00, 0x00, 0x00, 0x00 };
+	int key = flags | min_hz << 8 | max_hz << 16;
+	u8 sum = 0;
+	int i;
+
+	if (hdmi_ic_type != HDMI_IC_TYPE_FLAVA3 || hdr_enabled)
+		return;
+	if (key == vrr_vsif_last)
+		return;
+
+	if (!(flags & 0x02)) {
+		/* VRR off in the settings or not supported in this mode: stop sending ours */
+		if (vrr_vsif_on) {
+			i2c_init(1);
+			i2c_mask(0x7203, 0x00, 0x01);
+			i2c_exec();
+			vrr_vsif_on = false;
+			pr_info("FreeSync InfoFrame off\n");
+		}
+		vrr_vsif_last = key;
+		return;
+	}
+
+	pkt[9] = flags;
+	pkt[10] = min_hz;
+	pkt[11] = max_hz;
+	for (i = 0; i < 4 + 8; i++)
+		sum += pkt[i];
+	pkt[3] = (u8)(0x100 - sum);
+
+	i2c_init(1);
+	i2c_write_data(0x7e40, pkt, sizeof(pkt));
+	i2c_mask(0x7203, 0x01, 0x01);
+	i2c_write(0x7204, 0x01);
+	i2c_waitclear(0x7204, 0x01);
+	i2c_exec();
+
+	vrr_vsif_last = key;
+	vrr_vsif_on = true;
+	pr_info("FreeSync InfoFrame: %s%s%s, %u-%u Hz\n",
+		flags & 0x01 ? "supported" : "-", flags & 0x02 ? " enabled" : "",
+		flags & 0x04 ? " active" : "", min_hz, max_hz);
+}
+EXPORT_SYMBOL(sceHdmiSetFreesyncInfoframe);
+
 /*
  * The modes the HDMI bridge has a setup for, in their standard timings:
  * 1080p60 (VIC 16), 1080p120 (VIC 63), 2160p60 (VIC 97), 1440p60 (VESA DMT
@@ -1731,6 +1894,7 @@ void hdmi_notification_handler(struct icc_msg *msg)
 		if (msg->data[1] == 0x02) {
 			fix_edid(&msg->data[4]);
 			real_edid = drm_edid_alloc(&msg->data[4], *(u16 *)&msg->data[2]);
+			ps5_vrr_save_edid(msg);
 			pr_info("got real edid\n");
 			sceHdmiOutputMode();
 
