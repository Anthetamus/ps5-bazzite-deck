+/*
+ * Experimental: allow 2560x1440@120 (497.75 MHz, above the 340 MHz HDMI 1.4
+ * limit). On FLAVA3 the bridge is then set up like 4K60: TMDS 1/40 clock ratio
+ * and scrambling (SCDC 0x20 = 0x03). Off by default: hdmi.allow_1440p120=1.
+ */
+static bool allow_1440p120;
+module_param(allow_1440p120, bool, 0444);
+MODULE_PARM_DESC(allow_1440p120, "Experimental: allow 1440p120 (default: off)");
+
+static bool hdmi_mode_is_hi_rate(const struct drm_display_mode *mode)
+{
+	return mode->clock > 340000;
+}
+
 bool isHdmiModeValid(const struct drm_display_mode *mode, int force_1080p)
 {
 	u8 vic = drm_match_cea_mode(mode);
@@ -1236,6 +1252,8 @@ bool isHdmiModeValid(const struct drm_display_mode *mode, int force_1080p)
 
 	/* 1440p */
 	if (mode->hdisplay == 2560 && mode->vdisplay == 1440) {
+		if (allow_1440p120 && mode->clock == 497750)
+			return true;
 		return mode->clock == 241500 || mode->clock == 241700;
 	}
 
