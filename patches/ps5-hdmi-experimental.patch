PS5 HDMI: experimental options                            [ps5-bazzite-deck]

1. hdmi.vrr=1 (default off): offer VRR. The bridge reports neither the MSA-
   ignore capability nor Adaptive-Sync, and 7.3 doesn't read the VRR range of
   HDMI sinks; with the option the bridge is treated as MSA-ignore capable and
   the range comes from the sink's AMD FreeSync block, else its HDMI Forum VRR
   range. Whether the bridge passes a varying frame timing on is untested.
2. hdmi.dp_link_lock (default on): train the DP link to the bridge at its full
   verified rate (4 lanes HBR3) for every mode instead of the lowest rate the
   mode needs; reports say the bridge sometimes fails to sync on lower rates.
---

diff --git a/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm_connector.c b/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm_connector.c
index 569003a81..ce972f603 100644
--- a/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm_connector.c
+++ b/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm_connector.c
@@ -1612,6 +1612,22 @@ create_stream_for_sink(struct drm_connector *connector,
 
 #ifdef CONFIG_X86_PS5
 	ps5_hdmi_fixup_timing(&mode);
+	if (ps5_hdmi_dp_link_lock() && aconnector && aconnector->dc_link &&
+	    aconnector->dc_link->verified_link_cap.lane_count != LANE_COUNT_UNKNOWN &&
+	    aconnector->dc_link->verified_link_cap.link_rate != LINK_RATE_UNKNOWN) {
+		struct dc_link *link = aconnector->dc_link;
+
+		/* train at the full verified rate for every mode (see hdmi.dp_link_lock) */
+		if (link->preferred_link_setting.lane_count != link->verified_link_cap.lane_count ||
+		    link->preferred_link_setting.link_rate != link->verified_link_cap.link_rate) {
+			link->preferred_link_setting.lane_count = link->verified_link_cap.lane_count;
+			link->preferred_link_setting.link_rate = link->verified_link_cap.link_rate;
+			link->preferred_link_setting.link_spread = link->verified_link_cap.link_spread;
+			link->preferred_link_setting.use_link_rate_set = false;
+			pr_info("PS5: DP link locked to %d lanes, rate 0x%x\n",
+				link->verified_link_cap.lane_count, link->verified_link_cap.link_rate);
+		}
+	}
 #endif
 
 	/*
@@ -4029,6 +4045,15 @@ void amdgpu_dm_update_freesync_caps(struct drm_connector *connector,
 	     connector->display_info.monitor_range.max_vfreq == 0))
 		parse_edid_displayid_vrr(connector, edid);
 
+#ifdef CONFIG_X86_PS5
+	if (amdgpu_dm_connector->dc_link) {
+		struct dc_link *link = amdgpu_dm_connector->dc_link;
+
+		if (ps5_hdmi_vrr_enabled())
+			link->dpcd_caps.allow_invalid_MSA_timing_param = true;
+	}
+#endif
+
 	if (edid && (sink->sink_signal == SIGNAL_TYPE_DISPLAY_PORT ||
 		     sink->sink_signal == SIGNAL_TYPE_EDP)) {
 		if (amdgpu_dm_connector->dc_link &&
@@ -4089,6 +4114,23 @@ void amdgpu_dm_update_freesync_caps(struct drm_connector *connector,
 		}
 	}
 
+#ifdef CONFIG_X86_PS5
+	if (ps5_hdmi_vrr_enabled()) {
+		int lo = 0, hi = 0;
+		const char *src = "none";
+
+		if (!freesync_capable && !ps5_hdmi_vrr_range(&lo, &hi, &src)) {
+			amdgpu_dm_connector->min_vfreq = lo;
+			amdgpu_dm_connector->max_vfreq = hi;
+			freesync_capable = true;
+		}
+		drm_info(connector->dev, "PS5 VRR: %s, range %d-%d Hz (%s)\n",
+			 freesync_capable ? "offered" : "not offered (no range in the EDID)",
+			 amdgpu_dm_connector->min_vfreq, amdgpu_dm_connector->max_vfreq,
+			 freesync_capable ? src : "turn on VRR / FreeSync in the TV's settings");
+	}
+#endif
+
 	/* Handle MCCS */
 	if (do_mccs) {
 		dm_helpers_read_mccs_caps(adev->dm.dc->ctx, amdgpu_dm_connector->dc_link, sink);
diff --git a/drivers/ps5/hdmi.c b/drivers/ps5/hdmi.c
index fb0580f54..81785c86b 100644
--- a/drivers/ps5/hdmi.c
+++ b/drivers/ps5/hdmi.c
@@ -1333,6 +1333,90 @@ bool isHdmiModeValid(const struct drm_display_mode *mode, int force_1080p)
 }
 EXPORT_SYMBOL(isHdmiModeValid);
 
+/*
+ * Experimental VRR (hdmi.vrr=1, default off). amdgpu offers VRR on a DP sink
+ * that may ignore the MSA timing parameters and has a refresh range; the PS5's
+ * HDMI bridge reports neither, and the 7.3 EDID parser doesn't read the VRR
+ * range from HDMI sinks' VRR blocks. So with hdmi.vrr=1 the bridge is treated
+ * as MSA-ignore capable and the range comes from the sink's EDID: the AMD
+ * FreeSync block, else the HDMI Forum VRR range. (Not the range limits
+ * descriptor: TVs list one without supporting VRR, and with VRR switched off
+ * in the TV the VRR blocks are gone.) Whether the bridge passes a varying
+ * frame timing on to the sink is what this is for.
+ */
+static bool vrr;
+module_param(vrr, bool, 0444);
+MODULE_PARM_DESC(vrr, "Experimental: offer VRR on the HDMI output (default: off)");
+
+static u8 vrr_edid[512];
+static int vrr_edid_len;
+
+/*
+ * Test: hdmi.dp_link_lock (default on in this test build). Train the DP link
+ * to the HDMI bridge at its full verified rate (4 lanes HBR3 on the PS5) for
+ * every mode, instead of the lowest rate the mode needs. Reports say the bridge
+ * sometimes fails to sync on the lower rates amdgpu picks below 4K.
+ */
+static bool dp_link_lock = true;
+module_param(dp_link_lock, bool, 0444);
+MODULE_PARM_DESC(dp_link_lock, "Test: always train the DP link to the bridge at full rate (default: on)");
+
+bool ps5_hdmi_dp_link_lock(void)
+{
+	return dp_link_lock;
+}
+EXPORT_SYMBOL(ps5_hdmi_dp_link_lock);
+
+bool ps5_hdmi_vrr_enabled(void)
+{
+	return vrr;
+}
+EXPORT_SYMBOL(ps5_hdmi_vrr_enabled);
+
+int ps5_hdmi_vrr_range(int *min_hz, int *max_hz, const char **src)
+{
+	int amd_min = 0, amd_max = 0, hf_min = 0, hf_max = 0;
+	int ext, n, i;
+
+	if (vrr_edid_len < 128)
+		return -ENODATA;
+
+	n = vrr_edid[0x7e];
+	for (ext = 1; ext <= n && (ext + 1) * 128 <= vrr_edid_len; ext++) {
+		const u8 *b = &vrr_edid[ext * 128];
+		int d = b[2];
+
+		if (b[0] != 0x02 || d < 4 || d > 127)
+			continue;
+		for (i = 4; i < d; i += 1 + (b[i] & 0x1f)) {
+			int tag = b[i] >> 5, l = b[i] & 0x1f;
+			const u8 *p = &b[i + 1];
+
+			if (tag != 3 || l < 3 || i + 1 + l > d)
+				continue;
+			if (p[0] == 0x1a && p[1] == 0x00 && p[2] == 0x00 && l >= 7) {
+				/* AMD FreeSync VSDB: version, flags, min, max */
+				amd_min = p[5];
+				amd_max = p[6];
+			} else if (p[0] == 0xd8 && p[1] == 0x5d && p[2] == 0xc4 && l >= 10) {
+				/* HDMI Forum VSDB: VRRmin [5:0], VRRmax [9:0] */
+				hf_min = p[8] & 0x3f;
+				hf_max = ((p[8] & 0xc0) << 2) | p[9];
+			}
+		}
+	}
+
+	if (amd_min && amd_max > amd_min + 10) {
+		*min_hz = amd_min; *max_hz = amd_max; *src = "FreeSync block";
+	} else if (hf_min && hf_max > hf_min + 10) {
+		*min_hz = hf_min; *max_hz = hf_max; *src = "HDMI VRR range";
+	} else {
+		return -ENODATA;
+	}
+	return 0;
+}
+EXPORT_SYMBOL(ps5_hdmi_vrr_range);
+
 /*
  * The modes the HDMI bridge has a setup for, in their standard timings:
  * 1080p60 (VIC 16), 1080p120 (VIC 63), 2160p60 (VIC 97), 1440p60 (VESA DMT
@@ -1734,6 +1818,8 @@ void hdmi_notification_handler(struct icc_msg *msg)
 		if (msg->data[1] == 0x02) {
 			fix_edid(&msg->data[4]);
 			real_edid = drm_edid_alloc(&msg->data[4], *(u16 *)&msg->data[2]);
+			vrr_edid_len = min_t(int, *(u16 *)&msg->data[2], sizeof(vrr_edid));
+			memcpy(vrr_edid, &msg->data[4], vrr_edid_len);
 			pr_info("got real edid\n");
 			sceHdmiOutputMode();
 
