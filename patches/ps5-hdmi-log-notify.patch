PS5 HDMI: hdmi.log_notify=1 (default off) logs every bridge notification
and every picture setup with timestamps, for black-screen reports.
---

diff --git a/drivers/ps5/hdmi.c b/drivers/ps5/hdmi.c
index 6b6c3e3a3..8a5f3effd 100644
--- a/drivers/ps5/hdmi.c
+++ b/drivers/ps5/hdmi.c
@@ -128,6 +128,14 @@ static bool scrambling;
 static bool hdr_enabled;
 static bool bt2020_enabled;
 
+/*
+ * hdmi.log_notify=1: log every notification from the HDMI bridge and every
+ * picture setup, with timestamps, to see where a black screen starts.
+ */
+static bool log_notify;
+module_param(log_notify, bool, 0644);
+MODULE_PARM_DESC(log_notify, "Log HDMI bridge notifications and picture setups (default: off)");
+
 static void i2c_init(u8 code)
 {
 	i2c_ctx.msg_cur = i2c_ctx.msg_buf;
@@ -1181,6 +1189,10 @@ EXPORT_SYMBOL(sceHdmiInitVideoConfig);
 
 void sceHdmiSetVideoConfig(const struct drm_display_mode *mode, unsigned int bpc, bool yuv422)
 {
+	if (log_notify)
+		pr_info("setup: %s@%d %d kHz vic %d, %u bpc %s\n", mode->name,
+			drm_mode_vrefresh(mode), mode->clock, drm_match_cea_mode(mode),
+			bpc, yuv422 ? "YCbCr 4:2:2" : "RGB");
 	if (hdmi_ic_type == HDMI_IC_TYPE_FLAVA3) {
 		setHdmiVideoConfigFlava3(mode, bpc, yuv422);
 	} else {
@@ -1710,6 +1722,9 @@ void hdmi_notification_handler(struct icc_msg *msg)
 	u32 crc;
 	bool other;
 
+	if (log_notify)
+		pr_info("notify: 0x%02x (%*ph)\n", msg->data[1], 4, msg->data);
+
 		if (msg->data[1] == 0x02) {
 			fix_edid(&msg->data[4]);
 			real_edid = drm_edid_alloc(&msg->data[4], *(u16 *)&msg->data[2]);
