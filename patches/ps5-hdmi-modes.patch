@@ -2501,6 +2505,16 @@ enum drm_mode_status amdgpu_dm_connector_mode_valid(struct drm_connector *connec
 #ifdef CONFIG_X86_PS5
 	if (!isHdmiModeValid(mode, amdgpu_force_1080p))
 		return MODE_ERROR;
