+/*
+ * 2560x1440@120 (497.75 MHz, above the 340 MHz HDMI 1.4 limit) is allowed on
+ * FLAVA3, where the bridge is set up like 4K60 for it (TMDS 1/40 clock ratio,
+ * scrambling). Other bridges have no high-bandwidth setup for 1440p.
+ */
+
+static bool hdmi_mode_is_hi_rate(const struct drm_display_mode *mode)
+{
+	return mode->clock > 340000;
+}
+
 bool isHdmiModeValid(const struct drm_display_mode *mode, int force_1080p)
 {
 	u8 vic = drm_match_cea_mode(mode);
@@ -1240,6 +1255,8 @@ bool isHdmiModeValid(const struct drm_display_mode *mode, int force_1080p)
 
 	/* 1440p */
 	if (mode->hdisplay == 2560 && mode->vdisplay == 1440) {
+		if (hdmi_ic_type == HDMI_IC_TYPE_FLAVA3 && mode->clock == 497750)
+			return true;
 		return mode->clock == 241500 || mode->clock == 241700;
 	}
 
@@ -1254,6 +1271,96 @@ bool isHdmiModeValid(const struct drm_display_mode *mode, int force_1080p)
 }
 EXPORT_SYMBOL(isHdmiModeValid);
 
+/*
+ * Many TVs list 1440p only at 120 Hz. On FLAVA3, add the standard 1440p60
+ * timing (VESA DMT 2560x1440@60 reduced blanking, 241.5 MHz) when the sink
+ * offers 1440p but not at 60 Hz: it is the timing the bridge's 1440p setup is
+ * made for (back porches 80 px / 33 lines, so nothing to move).
+ */
+static const struct drm_display_mode ps5_1440p60 = {
+	DRM_MODE("2560x1440", DRM_MODE_TYPE_DRIVER, 241500,
+		 2560, 2608, 2640, 2720, 0, 1440, 1443, 1448, 1481, 0,
+		 DRM_MODE_FLAG_PHSYNC | DRM_MODE_FLAG_NVSYNC)
+};
+
+int ps5_hdmi_add_modes(struct drm_connector *connector)
+{
+	struct drm_display_mode *m, *mode;
+	bool has_1440 = false;
+
+	if (hdmi_ic_type != HDMI_IC_TYPE_FLAVA3)
+		return 0;
+
+	list_for_each_entry(m, &connector->probed_modes, head) {
+		if (m->hdisplay != 2560 || m->vdisplay != 1440)
+			continue;
+		if (m->clock == 241500 || m->clock == 241700)
+			return 0;	/* the sink already offers 1440p60 */
+		has_1440 = true;
+	}
+	if (!has_1440)
+		return 0;
+
+	mode = drm_mode_duplicate(connector->dev, &ps5_1440p60);
+	if (!mode)
+		return 0;
+	drm_mode_probed_add(connector, mode);
+	pr_info_once("added 2560x1440@60 (sink lists 1440p only at other rates)\n");
+	return 1;
+}
+EXPORT_SYMBOL(ps5_hdmi_add_modes);
+
+/*
+ * FLAVA3 places a 1440p picture as if the signal had the back porches of
+ * CVT-RB 2560x1440@60 (80 px / 33 lines), whatever timing it really gets.
+ * Other 1440p timings (e.g. a desktop-generated CVT 1440p60, or a TV's
+ * 1440p120 with a longer vertical back porch) end up shifted right or down
+ * by the difference. Move the sync pulses so the real back porches match.
+ * Active area, totals and pixel clock (so the refresh rate) are unchanged.
+ */
+#define PS5_FLAVA3_1440P_HBP	80
+#define PS5_FLAVA3_1440P_VBP	33
+
+static bool ps5_move_sync(int disp, int total, int bp, u16 *start, u16 *end)
+{
+	int width = *end - *start;
+	int new_end = total - bp;
+	int new_start = new_end - width;
+
+	if (width <= 0 || new_start <= disp || new_end == *end)
+		return false;
+	*start = new_start;
+	*end = new_end;
+	return true;
+}
+
+void ps5_hdmi_fixup_timing(struct drm_display_mode *m)
+{
+	static u16 last_hs, last_vs;
+	bool h, v;
+
+	if (hdmi_ic_type != HDMI_IC_TYPE_FLAVA3 ||
+	    m->hdisplay != 2560 || m->vdisplay != 1440)
+		return;
+
+	h = ps5_move_sync(m->hdisplay, m->htotal, PS5_FLAVA3_1440P_HBP,
+			  &m->hsync_start, &m->hsync_end);
+	v = ps5_move_sync(m->vdisplay, m->vtotal, PS5_FLAVA3_1440P_VBP,
+			  &m->vsync_start, &m->vsync_end);
+	ps5_move_sync(m->crtc_hdisplay, m->crtc_htotal, PS5_FLAVA3_1440P_HBP,
+		      &m->crtc_hsync_start, &m->crtc_hsync_end);
+	ps5_move_sync(m->crtc_vdisplay, m->crtc_vtotal, PS5_FLAVA3_1440P_VBP,
+		      &m->crtc_vsync_start, &m->crtc_vsync_end);
+	if ((h || v) && (m->hsync_start != last_hs || m->vsync_start != last_vs)) {
+		last_hs = m->hsync_start;
+		last_vs = m->vsync_start;
+		pr_info("FLAVA3 1440p: syncs moved for back porch %d/%d (hsync %d-%d, vsync %d-%d)\n",
+			PS5_FLAVA3_1440P_HBP, PS5_FLAVA3_1440P_VBP,
+			m->hsync_start, m->hsync_end, m->vsync_start, m->vsync_end);
+	}
+}
+EXPORT_SYMBOL(ps5_hdmi_fixup_timing);
+
