PS5 HDMI output fixes                                     [ps5-bazzite-deck]

1. FLAVA3: after a mode above 340 MHz (4K60) turned SCDC scrambling on in the
   sink, turn it off again for lower modes; otherwise the sink shows "no
   signal" after switching from 4K down to 1080p/1080p120.
2. FLAVA3: don't program the "back to unplugged" / "back to wait resolution"
   event sequences that #43 enabled: on some TVs they make the bridge
   re-announce the sink during the first modeset, link training fails and the
   screen stays black until a re-plug.
3. Hotplug (#43): run the hotplug work on the unbound system queue (removes
   the "hogged CPU" workqueue warning).

diff --git a/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm.c b/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm.c
index 33120dafa..20bf3621a 100644
--- a/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm.c
+++ b/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm.c
@@ -1361,7 +1361,7 @@ static void dm_ps5_hotplug_handler(void *data)
 {
 	struct amdgpu_display_manager *dm = data;
 
-	queue_work(system_percpu_wq, &dm->ps5_hotplug_work);
+	queue_work(system_dfl_wq, &dm->ps5_hotplug_work);
 }
 #endif
 
diff --git a/drivers/ps5/hdmi.c b/drivers/ps5/hdmi.c
index 7efe015b9..6dc503d04 100644
--- a/drivers/ps5/hdmi.c
+++ b/drivers/ps5/hdmi.c
@@ -535,9 +535,13 @@ static void sceControlHdmiEvent(u8 enable)
 void hdmiSystemResume(void)
 {
 	if (hdmi_ic_type == HDMI_IC_TYPE_FLAVA3) {
-		/* Needed for audio to come back after a replug. */
-		sceSetBackToUnpluggedSequence();
-		sceSetBackToWaitResolutionSequence();
+		/*
+		 * Not programmed: with these event sequences the FLAVA3 bridge re-announces
+		 * the sink during the first modeset on some TVs, link training fails and the
+		 * bridge stays without video until a replug (as before ps5-linux-patches #43).
+		 */
+		// sceSetBackToUnpluggedSequence();
+		// sceSetBackToWaitResolutionSequence();
 		i2c_cmd_4_2();
 		// sceSetHdcpSequence1st();
 		// sceSetHdcpSequence2nd();
@@ -832,6 +836,9 @@ static void setHdmiBasicVideoConfigFlava3(const struct drm_display_mode *mode)
 	i2c_exec();
 }
 
+/* Whether the sink currently has SCDC scrambling enabled by us. */
+static bool flava3_scrambling;
+
 static void setVideoAdditionalConfigFlava3(const struct drm_display_mode *mode)
 {
 	u8 vic = drm_match_cea_mode(mode);
@@ -867,13 +874,24 @@ static void setVideoAdditionalConfigFlava3(const struct drm_display_mode *mode)
 	i2c_begin_block();
 	i2c_write(0x7a8b, 0x05);
 	if (vic == 97) {
+		/* SCDC (DDC 0x54) TMDS_Config = scrambling + 1/40 clock ratio */
 		i2c_write(0x7c00, 0x03);
 		i2c_write_data(0x7a80, (u8[]){0xa8, 0x20, 0x00, 0x80}, 4);
+	} else if (flava3_scrambling) {
+		/*
+		 * The previous mode turned scrambling on in the sink. Turn it off
+		 * again, otherwise the sink keeps expecting a scrambled signal and
+		 * shows "no signal" after switching down from 4K60 (e.g. to 1080p).
+		 * Only done when we enabled it ourselves, so SCDC is known to exist.
+		 */
+		i2c_write(0x7c00, 0x00);
+		i2c_write_data(0x7a80, (u8[]){0xa8, 0x20, 0x00, 0x80}, 4);
 	}
 	i2c_end_block();
-	if (vic == 97) {
+	if (vic == 97 || flava3_scrambling) {
 		i2c_waitclear(0x7a84, 0x01);
 	}
+	flava3_scrambling = (vic == 97);
 	i2c_begin_block();
 	i2c_write(0x7021, 0xff);
 	i2c_write(0x700a, 0x02);
