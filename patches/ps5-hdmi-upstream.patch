+#ifdef CONFIG_X86_PS5
+	dm_ps5_set_hdr_timing(timing_out, mode_in, connector_state);
+	/*
+	 * The HDMI bridges take RGB at 8 bpc only; deeper RGB comes out as
+	 * posterized contours. The one deep-colour output is HDR, sent as
+	 * 12 bpc YCbCr 4:2:2 above.
+	 */
+	if (timing_out->pixel_encoding == PIXEL_ENCODING_RGB &&
+	    timing_out->display_color_depth > COLOR_DEPTH_888)
+		timing_out->display_color_depth = COLOR_DEPTH_888;
+#endif
+
 	stream->output_color_space = amdgpu_dm_get_output_color_space(timing_out, connector_state);
 	stream->content_type = get_output_content_type(connector_state);
 }
